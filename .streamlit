[server]
# ป้องกันการโจมตี Cross-Site Request Forgery (CSRF)
enableXsrfProtection = true

# ป้องกันการรันสคริปต์ข้ามโดเมนที่ไม่ได้รับอนุญาต
enableCORS = false

# จำกัดขนาดไฟล์อัปโหลดไม่ให้เกิน 10MB เพื่อป้องกัน Denial of Service (DoS)
maxUploadSize = 10

[browser]
# ปิดการส่งสถิติการใช้งานออกไปภายนอก
gatherUsageStats = false